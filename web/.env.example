# Copy to .env.local. With AUTH_GITHUB_ID left empty, the site runs in demo mode:
# a demo user, example repos and the real demo-shop report, with no GitHub calls.

# Random secret that encrypts the session cookie: npx auth secret
AUTH_SECRET=

# From your GitHub App (Settings > Developer settings > GitHub Apps):
# Client ID and a generated client secret.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# The App's URL name, as in https://github.com/apps/<slug>. Used for "Allow more repos".
GITHUB_APP_SLUG=repeval
