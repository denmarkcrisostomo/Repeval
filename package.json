{
  "name": "repeval",
  "version": "0.1.0",
  "description": "Point it at a JS/TS repo: it generates unit and E2E tests, runs them, and keeps screenshots of every run.",
  "homepage": "https://github.com/denmarkcrisostomo/Repeval#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/denmarkcrisostomo/Repeval.git"
  },
  "bugs": {
    "url": "https://github.com/denmarkcrisostomo/Repeval/issues"
  },
  "type": "module",
  "bin": {
    "repeval": "dist/cli.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "build": "tsup && node scripts/build-report-app.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm run build && npm test"
  },
  "keywords": [
    "testing",
    "test-generation",
    "vitest",
    "playwright",
    "e2e",
    "cli"
  ],
  "license": "MIT",
  "dependencies": {
    "@inquirer/prompts": "^7.8.4",
    "@playwright/test": "1.63.0",
    "commander": "^14.0.0",
    "fast-glob": "^3.3.3",
    "picocolors": "^1.1.1",
    "ts-morph": "^26.0.0",
    "vitest": "^3.2.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "~19.1.0",
    "@types/react-dom": "~19.1.0",
    "@xyflow/react": "~12.8.4",
    "esbuild": "~0.25.9",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "tsup": "^8.5.0",
    "typescript": "~5.9.2"
  }
}
